# Test Environment Configuration
NODE_ENV=test
PORT=5001

# Test Database (using same database with different collection prefix)
MONGODB_URI=mongodb://localhost:27017/giftkart_test

# JWT Secret for testing
JWT_SECRET=test_jwt_secret_for_testing_only
SESSION_SECRET=test_session_secret_for_testing_only

# Redis disabled for testing
REDIS_ENABLED=false

# Client URL for testing
CLIENT_URL=http://localhost:3000

# Google OAuth (mock values for testing)
GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
SERVER_URL=http://localhost:5001

# Razorpay (test keys)
RAZORPAY_KEY_ID=test_razorpay_key_id
RAZORPAY_KEY_SECRET=test_razorpay_key_secret

# Gemini API (mock for testing)
GEMINI_API_KEY=test_gemini_api_key

# Logging level for tests
LOG_LEVEL=error
